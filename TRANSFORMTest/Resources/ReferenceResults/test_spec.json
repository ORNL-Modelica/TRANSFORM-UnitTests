    {
      "model": "TRANSFORMTest.Nuclear.ReactorKinetics.Functions.PowerHistory_Steps",
      "description": "The function's gaps to the integrated equations, at the end of the history, must be below 1e-8 (they are 1.5e-10 to 4.1e-10); unitTests.x[3] (sum of Cs) is compared with its baseline.",
      "metrics": {
        "combinator": "and",
        "children": [
          {
            "metric": "range",
            "variable": "unitTests.x[1]",
            "min_value": 0,
            "max_value": 1e-08,
            "window": {
              "start": 200
            }
          },
          {
            "metric": "range",
            "variable": "unitTests.x[2]",
            "min_value": 0,
            "max_value": 1e-08,
            "window": {
              "start": 200
            }
          },
          {
            "metric": "nrmse",
            "variable": "unitTests.x[3]"
          }
        ]
      }
    },
